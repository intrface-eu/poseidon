{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.invalid/contracts/v1/command-ack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "device_id",
    "received_at",
    "outcome",
    "reason",
    "state_after",
    "sequence_seen"
  ],
  "properties": {
    "schema_version": {
      "const": "poseidon.command-ack.v1"
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "outcome": {
      "enum": [
        "accepted",
        "rejected",
        "expired",
        "duplicate",
        "executed",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "state_after": {
      "enum": [
        "observe",
        "armed",
        "inhibited",
        "fault",
        "emit"
      ]
    },
    "sequence_seen": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  }
}
