{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.invalid/contracts/v1/signed-manifest.schema.json",
  "title": "Poseidon signed-manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "poseidon.signed-manifest.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "config",
            "release",
            "update"
          ]
        },
        "target_kind": {
          "enum": [
            "hub",
            "reef"
          ]
        },
        "hardware_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "security_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "issued_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "previous_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "monitor_only": {
              "const": true
            },
            "telemetry_interval_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "offline_queue_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          },
          "required": [
            "monitor_only",
            "telemetry_interval_s",
            "offline_queue_limit"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "kind",
        "target_kind",
        "hardware_revision",
        "version",
        "sequence",
        "security_version",
        "issued_at",
        "expires_at",
        "artifact_sha256",
        "artifact_size_bytes",
        "previous_sha256",
        "config"
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "maxLength": 128
        },
        "canonicalization": {
          "const": "poseidon-json-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "maxLength": 88
        }
      },
      "required": [
        "algorithm",
        "key_id",
        "canonicalization",
        "value"
      ]
    }
  },
  "required": [
    "payload",
    "signature"
  ]
}
