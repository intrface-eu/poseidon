{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.invalid/contracts/v1/calibration-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "supersedes_id",
    "instrument_id",
    "quantity",
    "method",
    "reference_id",
    "operator_id",
    "key_id",
    "unit",
    "value",
    "uncertainty",
    "valid_from",
    "valid_until",
    "source_documents",
    "digital_only",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "poseidon.calibration-record.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "instrument_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "operator_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "unit": {
      "type": "string",
      "enum": [
        "1",
        "%",
        "Cel",
        "K",
        "Pa",
        "kPa",
        "m",
        "s",
        "Hz",
        "V",
        "mV",
        "A",
        "W",
        "mg/L",
        "g/L",
        "m/s",
        "dB",
        "[pH]"
      ]
    },
    "value": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "coverage_factor"
      ],
      "properties": {
        "value": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
        },
        "coverage_factor": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
        }
      }
    },
    "valid_from": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "digital_only": {
      "const": true
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "canonicalization": {
          "const": "poseidon-json-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  }
}
