{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poseidon.invalid/contracts/v1/clock-quality.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "unknown",
        "operator_declared",
        "synchronized",
        "holdover"
      ]
    },
    "method": {
      "enum": [
        "unknown",
        "operator_offset",
        "ntp",
        "gnss",
        "shared_clock",
        "measured_reference"
      ]
    },
    "uncertainty_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 604800000
        },
        {
          "type": "null"
        }
      ]
    },
    "offset_ms": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -604800000,
          "maximum": 604800000
        },
        {
          "type": "null"
        }
      ]
    },
    "reference": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "method",
    "uncertainty_ms",
    "offset_ms",
    "reference"
  ]
}
